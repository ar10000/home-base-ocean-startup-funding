{
  "realm": "home-base",
  "enabled": true,
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "verifyEmail": false,
  "accessTokenLifespan": 300,
  "clients": [
    {
      "clientId": "home-base-web",
      "name": "Home Base (local)",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:5173/*"],
      "webOrigins": ["http://localhost:5173"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*"
      },
      "protocolMappers": [
        {
          "name": "api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": { "included.custom.audience": "home-base-api", "access.token.claim": "true" }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "founder@example.test",
      "enabled": true,
      "email": "founder@example.test",
      "emailVerified": true,
      "firstName": "Inês",
      "lastName": "Example",
      "credentials": [{ "type": "password", "value": "local-only-not-a-secret", "temporary": false }]
    }
  ]
}
